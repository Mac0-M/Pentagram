# MongoDB Connection String
# Format: mongodb://username:password@host:port/database
# Local: mongodb://localhost:27017/pentagram
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/pentagram
MONGO_URI=mongodb+srv://admin:1234@cluster0.grgep3u.mongodb.net/pentagram
# Server Port
PORT=3000

# Riot Games API Key
# Get your key from: https://developer.riotgames.com/
RIOT_API_KEY=your_riot_api_key_here

# Riot Games Region
# Options: sea, asia, americas, europe, etc.
RIOT_REGION=sea

# OpenDota API Base URL (usually doesn't need to change)
OPEN_DOTA_BASE_URL=https://api.opendota.com/api
